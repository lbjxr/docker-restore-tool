# Example configuration for Docker Restore Tool
# Copy to .env or another file, then load with:
#   bash docker_restore.sh --config .env

REMOTE_NAME=infini
REMOTE_DIR=Backup/RN/Docker
RESTORE_ROOT=/opt
TEMP_DIR=/tmp/docker_restore_work
LOG_FILE=/tmp/docker_restore.log

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: comma-separated project list for verification
# Use with CLI: --projects NginxProxyManager,openlist,komari
