# Example configuration for Docker Backup + Restore Tool
# Copy to .env or another file, then load with:
#   bash docker_restore.sh --config .env

REMOTE_NAME=infinicloud
REMOTE_DIR=Backup/FOSSVPS/Docker
RESTORE_ROOT=/opt
TEMP_DIR=/tmp/docker_restore_work
LOG_FILE=/tmp/docker_restore.log

# Backup settings
BACKUP_SOURCE_ROOT=/opt
BACKUP_PROJECTS=NginxProxyManager,Resin,NewsFocus
# Optional explicit CSV consumed by the backup command after config load.
# Prefer setting this as well when you want a machine-specific list to be unambiguous.
# BACKUP_PROJECTS_CSV=NginxProxyManager,Resin,NewsFocus
BACKUP_RETENTION=7d
BACKUP_REQUIRED_SPACE_KB=1048576
SERVER_NAME=

# Optional: extra tar exclude patterns appended to the script's built-in conservative defaults.
# Example:
# BACKUP_EXCLUDES=*/node_modules/*,*/tmp/*,*/logs/archive/*
BACKUP_EXCLUDES=

# The script already applies a conservative built-in exclude list for:
# - Resin runtime logs / cache
# - NginxProxyManager logs
# - NewsFocus deploy cache
# - Git metadata
# Keep backups focused on restorable app data instead of noisy runtime files.
#
# Important:
# - backup currently packages directories more naturally than standalone files.
# - if you need to preserve a small set of important single files, place copied files
#   into a dedicated directory such as /opt/docker-restore-tool/extra-core and include
#   that directory in BACKUP_PROJECTS / BACKUP_PROJECTS_CSV.

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: comma-separated project list for restore verification
# If omitted, the script auto-detects top-level directories under RESTORE_ROOT from the archive
# Use with CLI: --projects NginxProxyManager,Resin,NewsFocus
